[Unit]
Description=Paula Job Agent – Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paula
WorkingDirectory=/opt/paula
EnvironmentFile=/opt/paula/.env
ExecStart=/opt/paula/.venv/bin/paula bot
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/paula/data

[Install]
WantedBy=multi-user.target
