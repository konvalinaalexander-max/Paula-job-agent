[Unit]
Description=Paula Job Agent – sweep-companies (nachts)

[Service]
Type=oneshot
User=paula
WorkingDirectory=/opt/paula
EnvironmentFile=/opt/paula/.env
ExecStart=/opt/paula/.venv/bin/paula sweep-companies
TimeoutStartSec=90min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/paula/data
