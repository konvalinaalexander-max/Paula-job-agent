[Unit]
Description=Paula Job Agent – run-cycle (scan-inbox → process-replies → sweep-portals → send-approved → reminders)

[Service]
Type=oneshot
User=paula
WorkingDirectory=/opt/paula
EnvironmentFile=/opt/paula/.env
ExecStart=/opt/paula/.venv/bin/paula run-cycle
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/paula/data
