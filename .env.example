# Diese Werte werden als Geheimnisse in der Umgebung hinterlegt, in der die
# Routinen laufen - NICHT in diese Datei eintragen und NICHT ins Repo committen.

# --- Gmail (nur lesend) ---
# Inhalt der von Google heruntergeladenen OAuth-Datei (Desktop-App)
GMAIL_CLIENT_SECRET_JSON=
# Wird von scripts/gmail_auth.py erzeugt, nachdem Paula sich angemeldet hat
GMAIL_TOKEN_JSON=

# --- Adzuna (Stellenquelle Oesterreich) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Dashboard ---
# Adresse der veroeffentlichten Seite, in die geschrieben wird
DASHBOARD_URL=

# --- Optional ---
# Mailadresse fuer Betriebsmeldungen an Alexander
ADMIN_EMAIL=
