# Diese Werte werden als Umgebungsvariablen in der Umgebung hinterlegt,
# in der die Läufe stattfinden - NICHT hier eintragen, NICHT ins Repo.
# Anleitung: deploy/SETUP.md

# --- Paulas Mailbox (nur lesen) ---
# Ihre vollstaendige Mailadresse
PAULA_IMAP_USER=
# Das 16-stellige App-Passwort aus ihrem Google-Konto
# (myaccount.google.com/apppasswords - braucht aktive Zwei-Faktor-Anmeldung)
PAULA_IMAP_PASSWORD=
# Optional, Vorgabe imap.gmail.com
PAULA_IMAP_HOST=

# --- Stellenquellen (ab M4) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Dashboard ---
DASHBOARD_URL=
