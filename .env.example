# Kopieren nach .env (nur auf dem Server, chmod 600). NIE committen.

ANTHROPIC_API_KEY=sk-ant-...

TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_USER_CHAT_ID=          # Paulas Chat-ID (Bot loggt sie beim ersten /start)
TELEGRAM_ADMIN_CHAT_ID=         # Alexanders Chat-ID

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional – nur wenn Zefix genutzt wird (M7, Schweiz)
ZEFIX_USER=
ZEFIX_PASSWORD=

# Optional – nur wenn Paulas Konto NICHT bei Google ist (IMAP-Fallback)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587

# Pfade (Defaults passen für /opt/paula)
PAULA_DATA_DIR=./data
PAULA_CONFIG_DIR=./config
